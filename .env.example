SALESFORCE_API_VERSION=66.0
SALESFORCE_LOGIN_URL=https://your-domain.my.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
PORT=3000

# AI query assistant. Configure one or more providers; switch between them in the UI.
# LLM_PROVIDER picks the default; LLM_MODEL and LLM_BASE_URL apply to that default only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPEN_ROUTER_API_KEY=
LLM_PROVIDER=
LLM_MODEL=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Salesforce SOQL Playground

# Local Claude Code CLI (uses your Claude Code login, no API key). Models: sonnet, opus, haiku.
CLAUDE_CODE_ENABLED=false
CLAUDE_CODE_MODEL=sonnet
CLAUDE_CODE_PATH=

# Local GitHub Copilot CLI (uses your Copilot login, no API key). Model "auto" lets Copilot pick.
COPILOT_ENABLED=false
COPILOT_MODEL=auto
COPILOT_PATH=
